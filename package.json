{
  "name": "old-vk-resume",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "tsx --tsconfig tsconfig.node.json scripts/ensure-content.ts",
    "predev": "npm run setup",
    "precv": "npm run setup && npm run validate-content",
    "prebuild": "npm run setup",
    "dev": "vite",
    "cv": "tsx --tsconfig tsconfig.node.json scripts/build-cv.tsx",
    "build": "npm run cv && tsc -b && vite build",
    "prevalidate-content": "npm run setup",
    "validate-content": "tsx --tsconfig tsconfig.node.json scripts/validate-content.ts",
    "pretypecheck": "npm run setup",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "^10.0.1",
    "@react-pdf/renderer": "^4.7.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "docx": "^9.7.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.17.0",
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
